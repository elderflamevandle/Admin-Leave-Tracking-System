# ─────────────────────────────────────────────────────────────────────────────
# Docker environment template
# Copy to .env.docker.local and fill in real values before running:
#   cp .env.docker .env.docker.local
#   docker compose --env-file .env.docker.local up -d
#
# NOTE: DATABASE_URL and DIRECT_URL are constructed automatically by
#       docker-compose.yml using POSTGRES_PASSWORD — do not set them here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=Admin@123

# ── App port (host-side) ──────────────────────────────────────────────────────
APP_PORT=3001

# ── Auth secrets — generate with: openssl rand -hex 32 ───────────────────────
JWT_SECRET=c8f2a1e9d4b7f3c6a9e2d5b8f1c4a7e0d3b6f9c2a5e8d1b4f7c0a3e6d9b2f5c8
JWT_REFRESH_SECRET=a3f6c9b2e5d8a1f4c7b0e3d6a9f2c5b8e1d4a7f0c3b6e9d2a5f8c1b4e7d0a3f6

# ── Email (optional — leave blank to disable) ────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@localhost

# ── Public URL (change to your domain / ngrok URL if needed) ─────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
