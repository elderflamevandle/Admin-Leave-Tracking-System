# ── Node / package managers ───────────────────────────────────────────────────
node_modules
.pnp
.pnp.*
.yarn
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Next.js build artifacts ───────────────────────────────────────────────────
.next
out
build

# ── Prisma generated client (rebuilt inside Docker) ──────────────────────────
src/generated

# ── Environment files (never bake secrets into the image) ────────────────────
.env
.env.*
!.env.example

# ── Git / editor / OS noise ───────────────────────────────────────────────────
.git
.gitignore
.github
.cursor
.claude
.vscode
.DS_Store
*.pem
Thumbs.db

# ── Test artifacts ────────────────────────────────────────────────────────────
coverage
test-results
playwright-report
/e2e

# ── Docs / planning (not needed at runtime) ───────────────────────────────────
*.md
docs
PRD
planner.md
impl_instruct.md
dummy-users.txt

# ── TypeScript build info ─────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts
